---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';
import { site } from '../../data/site';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', (p) => !p.data.href)).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const { title, client, year, role, stack, summary, colors, url, repo, cover, gallery } = project.data;
---

<Layout title={`${title} — ${site.name}`} description={summary}>
  <main class="case">
    <header class="case__head">
      <a class="mono case__back" href="/#works">← Все работы</a>
      <h1 class="case__title" transition:name={`project-${project.id}`}>{title}</h1>
      <p class="case__summary">{summary}</p>

      <dl class="case__meta">
        <div>
          <dt class="mono">Клиент</dt>
          <dd>{client}</dd>
        </div>
        <div>
          <dt class="mono">Год</dt>
          <dd>{year}</dd>
        </div>
        <div>
          <dt class="mono">Роль</dt>
          <dd>{role}</dd>
        </div>
        <div>
          <dt class="mono">Стек</dt>
          <dd>{stack.join(', ')}</dd>
        </div>
      </dl>

      {
        (url || repo) && (
          <div class="case__links">
            {url && (
              <a class="mono case__link" href={url} target="_blank" rel="noopener noreferrer">
                Открыть сайт ↗
              </a>
            )}
            {repo && (
              <a class="mono case__link" href={repo} target="_blank" rel="noopener noreferrer">
                Код на GitHub ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    <div class="case__cover" style={`--c1: ${colors[0]}; --c2: ${colors[1]}`} data-reveal>
      {cover && <Image class="case__shot" src={cover} alt={`${title} — главная страница`} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />}
    </div>

    <article class="case__body" data-reveal>
      <Content />
    </article>

    {
      gallery && (
        <div class="case__gallery">
          {gallery.map((shot) => (
            <figure class:list={['shot', { 'shot--tall': shot.src.height > shot.src.width }]} data-reveal>
              <Image src={shot.src} alt={shot.alt} widths={[600, 1000, 1400]} sizes="(max-width: 720px) 100vw, 50vw" />
              <figcaption class="mono">{shot.alt}</figcaption>
            </figure>
          ))}
        </div>
      )
    }

    <a class="next" href={`/work/${next.id}/`}>
      <span class="mono">(Следующий проект)</span>
      <span class="next__title">{next.data.title} <span class="next__arrow" aria-hidden="true">→</span></span>
    </a>
  </main>
  <Contact />
</Layout>

<style>
  .case__head {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 32px);
    padding: clamp(120px, 16vw, 200px) var(--gutter) clamp(48px, 6vw, 80px);
  }

  .case__back {
    width: fit-content;
    transition: color 0.3s var(--ease-out);
  }

  .case__back:hover {
    color: var(--accent);
  }

  .case__title {
    width: fit-content;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(48px, 10vw, 168px);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .case__summary {
    max-width: 640px;
    font-size: clamp(18px, 1.6vw, 22px);
    color: var(--soft);
  }

  .case__meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .case__meta dd {
    margin: 6px 0 0;
  }

  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
  }

  .case__link {
    width: fit-content;
    color: var(--accent);
  }

  .case__cover {
    height: clamp(260px, 50vw, 640px);
    margin-inline: var(--gutter);
    border-radius: 4px;
    overflow: hidden;
    background:
      radial-gradient(70% 90% at 25% 30%, var(--c1), transparent 70%),
      radial-gradient(60% 80% at 80% 75%, var(--c2), transparent 70%),
      #141418;
  }

  .case__shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .case__gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 32px);
    padding: 0 var(--gutter) clamp(64px, 10vw, 140px);
  }

  .shot {
    margin: 0;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
    border: 1px solid var(--line);
  }

  .shot figcaption {
    margin-top: 12px;
  }

  /* вертикальный скриншот (телефон) — по центру, узкой колонкой */
  .shot--tall {
    grid-column: 1 / -1;
    justify-self: center;
    width: min(100%, 340px);
  }

  .case__body {
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(64px, 10vw, 140px) var(--gutter);
    color: var(--soft);
  }

  .case__body :global(h2) {
    margin: 2.2em 0 0.6em;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 2.6vw, 34px);
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .case__body :global(h2:first-child) {
    margin-top: 0;
  }

  .case__body :global(p),
  .case__body :global(ul) {
    margin: 0 0 1em;
  }

  .case__body :global(li::marker) {
    color: var(--accent);
  }

  .case__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--fg);
  }

  .next {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(64px, 10vw, 140px) var(--gutter);
    border-top: 1px solid var(--line);
  }

  .next__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 8vw, 128px);
    line-height: 1;
    letter-spacing: -0.04em;
    transition: color 0.4s var(--ease-out);
  }

  .next__arrow {
    display: inline-block;
    transition: transform 0.6s var(--ease-out);
  }

  .next:hover .next__title {
    color: var(--accent);
  }

  .next:hover .next__arrow {
    transform: translateX(0.2em) rotate(-45deg);
  }

  @media (max-width: 720px) {
    .case__meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case__gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
